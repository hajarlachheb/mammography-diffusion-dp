# Copy to .env (never commit .env) and point these at your own copies of the data and outputs.
# Root with cbis-ddsm/{train,val,test} and bcdr/test (layout of mammo_dp/dataset16062024; see docs/datasets.md)
MDPD_DATA_ROOT=./data/dataset16062024
# Class-balanced synthetic pool with is_benign_false/ and is_benign_true/ (1,500 + 1,500 images)
MDPD_SYNTHETIC_DIR=./data/synthetic_ccnet
# Derived training folders (scripts/prepare_data.py build-folders)
MDPD_WORK_DIR=./work
# One sub-directory per run (checkpoints, logs, predictions)
MDPD_RESULTS_DIR=./runs
